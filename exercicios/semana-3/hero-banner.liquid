{% comment %}
  ==============================================================================
  SECTION: Hero Banner Dinâmico (Exercício 1 - Terça-feira)
  ==============================================================================
{% endcomment %}

{% schema %}
{
  "name": "Hero Banner Dinâmico",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Imagem de Fundo"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Cor do Overlay",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Opacidade do Overlay (%)",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 50
    },
    {
      "type": "range",
      "id": "altura_minima",
      "label": "Altura mínima",
      "min": 300,
      "max": 800,
      "step": 50,
      "default": 500,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "alinhamento",
      "label": "Alinhamento do conteúdo",
      "options": [
        { "value": "left", "label": "Esquerda" },
        { "value": "center", "label": "Centro" },
        { "value": "right", "label": "Direita" }
      ],
      "default": "center"
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Título",
      "settings": [
        {
          "type": "text",
          "id": "heading_text",
          "label": "Texto do Título",
          "default": "Título do Banner"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Cor do Título",
          "default": "#ffffff"
        },
        {
          "type": "select",
          "id": "heading_size",
          "label": "Tamanho do Título",
          "options": [
            { "value": "h1", "label": "Grande" },
            { "value": "h2", "label": "Médio" },
            { "value": "h3", "label": "Pequeno" }
          ],
          "default": "h1"
        }
      ]
    },
    {
      "type": "paragraph",
      "name": "Parágrafo",
      "settings": [
        {
          "type": "richtext",
          "id": "paragraph_text",
          "label": "Conteúdo",
          "default": "<p>Adicione um texto descritivo aqui para o seu banner.</p>"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Cor do Parágrafo",
          "default": "#ffffff"
        },
        {
          "type": "select",
          "id": "paragraph_size",
          "label": "Tamanho do Texto",
          "options": [
            { "value": "large", "label": "Grande" },
            { "value": "normal", "label": "Normal" },
            { "value": "small", "label": "Pequeno" }
          ],
          "default": "normal"
        }
      ]
    },
    {
      "type": "button",
      "name": "Botão",
      "settings": [
        {
          "type": "text",
          "id": "button_text",
          "label": "Texto do Botão",
          "default": "Ver mais"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "URL do Botão"
        },
        {
          "type": "select",
          "id": "estilo",
          "label": "Estilo",
          "options": [
            { "value": "primario", "label": "Primário (Preenchido)" },
            { "value": "secundario", "label": "Secundário (Contorno)" }
          ],
          "default": "primario"
        }
      ]
    },
    {
      "type": "image",
      "name": "Imagem",
      "settings": [
        {
          "type": "image_picker",
          "id": "block_image",
          "label": "Escolha uma Imagem"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt text"
        },
        {
          "type": "range",
          "id": "largura_maxima",
          "label": "Largura máxima (px)",
          "min": 50,
          "max": 400,
          "step": 10,
          "default": 200,
          "unit": "px"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Banner",
      "blocks": [{ "type": "heading" }, { "type": "paragraph" }, { "type": "button" }]
    }
  ]
}
{% endschema %}

<section
  class="hero-banner hero-banner-{{ section.id }}"
  style="min-height: {{ section.settings.altura_minima }}px;"
>
  {% if section.settings.background_image != blank %}
    <img
      class="hero-banner__background"
      src="{{ section.settings.background_image | image_url: width: 2000 }}"
      alt="{{ section.settings.background_image.alt | escape }}"
      width="{{ section.settings.background_image.width }}"
      height="{{ section.settings.background_image.height }}"
      loading="eager"
      fetchpriority="high"
    >
  {% endif %}

  <div class="hero-banner__content hero-banner__content--{{ section.settings.alinhamento }}">
    {% for block in section.blocks %}
      {% case block.type %}
        {% when 'heading' %}
          {% if block.settings.heading_text != blank %}
            <{{ block.settings.heading_size }}
              class="hero-banner__heading hero-banner__heading--{{ block.settings.heading_size }}"
              style="color: {{ block.settings.text_color }};"
              {{ block.shopify_attributes }}
            >
              {{ block.settings.heading_text | escape }}
            </{{ block.settings.heading_size }}>
          {% endif %}

        {% when 'paragraph' %}
          {% if block.settings.paragraph_text != blank %}
            <div
              class="hero-banner__paragraph hero-banner__paragraph--{{ block.settings.paragraph_size }}"
              style="color: {{ block.settings.text_color }};"
              {{ block.shopify_attributes }}
            >
              {{ block.settings.paragraph_text }}
            </div>
          {% endif %}

        {% when 'button' %}
          {% if block.settings.button_text != blank %}
            <a
              {% if block.settings.button_url == blank %}
                role="link"
                aria-disabled="true"
              {% else %}
                href="{{ block.settings.button_url }}"
              {% endif %}
              class="hero-banner__btn hero-banner__btn--{{ block.settings.estilo }}"
              {{ block.shopify_attributes }}
            >
              {{ block.settings.button_text | escape }}
            </a>
          {% endif %}

        {% when 'image' %}
          {% if block.settings.block_image != blank %}
            <div
              class="hero-banner__img-wrapper"
              {{ block.shopify_attributes }}
            >
              <img
                class="hero-banner__img"
                src="{{ block.settings.block_image | image_url: width: 800 }}"
                alt="{{ block.settings.alt_text | default: block.settings.block_image.alt | escape }}"
                width="{{ block.settings.block_image.width }}"
                height="{{ block.settings.block_image.height }}"
                loading="lazy"
                style="max-width: {{ block.settings.largura_maxima }}px;"
              >
            </div>
          {% endif %}
      {% endcase %}
    {% endfor %}
  </div>
</section>

<style>
  /* Container Principal */
  .hero-banner-{{ section.id }} {
    position: relative;
    min-height: {{ section.settings.altura_minima }}px;
    padding: 6rem 2rem;
    display: flex;
    align-items: center;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    overflow: hidden;
  }

  /* Overlay */
  .hero-banner-{{ section.id }}::after {
    content: "";
    position: absolute;
    inset: 0;
    background-color: {{ section.settings.overlay_color }};
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    z-index: 1;
    pointer-events: none;
  }

  .hero-banner__heading {
    margin: 0 0 1rem;
    line-height: 1.2;
  }

  /* Estilos de Tamanho do Parágrafo */
  .hero-banner__paragraph--large { font-size: 1.5rem; line-height: 1.4; margin-bottom: 1.5rem; }
  .hero-banner__paragraph--normal { font-size: 1.125rem; line-height: 1.6; margin-bottom: 1.5rem; }
  .hero-banner__paragraph--small { font-size: 0.9rem; line-height: 1.5; margin-bottom: 1.5rem; }

  .hero-banner__paragraph a {
    color: inherit;
  }

  .hero-banner__background {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  /* Container de conteúdo */
  .hero-banner__content {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 800px;
    display: flex;
    flex-direction: column;
    margin: 0 auto;
    box-sizing: border-box;
  }

  /* Ajuste de Alinhamento Dinâmico */
  .hero-banner__content--left { align-items: flex-start; text-align: left; }
  .hero-banner__content--center { align-items: center; text-align: center; }
  .hero-banner__content--right { align-items: flex-end; text-align: right; }

  /* Botões com Estilo Dinâmico */
  .hero-banner__btn {
    display: inline-block;
    padding: .75rem 2rem;
    text-decoration: none;
    border-radius: 4px;
    font-weight: bold;
    transition: opacity .2s ease;
  }
  .hero-banner__btn--primario { background-color: #000000; color: #ffffff; }
  .hero-banner__btn--secundario { background-color: transparent; border: 2px solid #000000; color: #000000; }

  /* Imagem com Largura Dinâmica */
  .hero-banner__img {
    height: auto;
    display: block;
    border-radius: 4px;
  }

  /* Responsividade (Mobile: sempre centralizado) */
  @media screen and (max-width: 768px) {
    .hero-banner-{{ section.id }} { min-height: 350px; padding: 4rem 1rem; }
    .hero-banner__content { align-items: center !important; text-align: center !important; }
  }
</style>
