{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    { "type": "image_picker", "id": "imagem_fundo", "label": "Imagem de fundo" },
    { "type": "color", "id": "cor_overlay", "label": "Cor do overlay", "default": "#000000" },
    {
      "type": "range",
      "id": "opacidade_overlay",
      "label": "Opacidade do overlay",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 40,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "altura_minima",
      "label": "Altura mínima",
      "min": 300,
      "max": 800,
      "step": 50,
      "default": 500,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "alinhamento",
      "label": "Alinhamento do conteúdo",
      "options": [
        { "value": "left", "label": "Esquerda" },
        { "value": "center", "label": "Centro" },
        { "value": "right", "label": "Direita" }
      ],
      "default": "center"
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Título",
      "settings": [
        { "type": "text", "id": "texto_titulo", "label": "Texto do título", "default": "Título do banner" },
        {
          "type": "select",
          "id": "tamanho_titulo",
          "label": "Tamanho",
          "options": [
            { "value": "h1", "label": "H1" },
            { "value": "h2", "label": "H2" },
            { "value": "h3", "label": "H3" }
          ],
          "default": "h1"
        },
        { "type": "color", "id": "cor_titulo", "label": "Cor do texto", "default": "#ffffff" }
      ]
    },
    {
      "type": "paragraph",
      "name": "Parágrafo",
      "settings": [
        { "type": "richtext", "id": "texto_paragrafo", "label": "Conteúdo", "default": "<p>Parágrafo do banner</p>" },
        { "type": "color", "id": "cor_paragrafo", "label": "Cor do texto", "default": "#ffffff" }
      ]
    },
    {
      "type": "button",
      "name": "Botão",
      "settings": [
        { "type": "text", "id": "texto_botao", "label": "Texto do botão", "default": "Botão" },
        { "type": "url", "id": "link_botao", "label": "Link" },
        { "type": "color", "id": "cor_botao", "label": "Cor do botão", "default": "#ffffff" },
        { "type": "color", "id": "cor_texto_botao", "label": "Cor do texto do botão", "default": "#000000" },
        {
          "type": "select",
          "id": "estilo_botao",
          "label": "Estilo",
          "options": [
            { "value": "primary", "label": "Preenchido" },
            { "value": "secondary", "label": "Contorno" }
          ],
          "default": "primary"
        }
      ]
    },
    {
      "type": "image",
      "name": "Imagem",
      "settings": [
        { "type": "image_picker", "id": "imagem", "label": "Imagem" },
        {
          "type": "range",
          "id": "largura_imagem",
          "label": "Largura máxima",
          "min": 50,
          "max": 400,
          "step": 50,
          "default": 200,
          "unit": "px"
        },
        { "type": "text", "id": "alt_imagem", "label": "Alt text", "default": "Imagem do banner" }
      ]
    }
  ],
  "presets": [
    { "name": "Hero Banner", "blocks": [{ "type": "heading" }, { "type": "paragraph" }, { "type": "button" }] }
  ]
}
{% endschema %}

{%- comment -%} 2.3 — Critical CSS inline: estilos acima do fold da section {%- endcomment -%}
<style>
  .hero-banner { position: relative; display: flex; align-items: center; overflow: hidden; padding: 60px 20px; }
  .hero-banner__imagem-fundo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0; }
  .hero-banner__overlay { position: absolute; inset: 0; z-index: 1; pointer-events: none; width: 100%; height: 100%; display: block; }
  .hero-banner__conteudo { position: relative; z-index: 2; width: 100%; max-width: 1200px; margin: 0 auto; display: flex; flex-direction: column; gap: 20px; }
  .hero-banner__conteudo--left { align-items: flex-start; text-align: left; }
  .hero-banner__conteudo--center { align-items: center; text-align: center; }
  .hero-banner__conteudo--right { align-items: flex-end; text-align: right; }
  .hero-banner__heading { margin: 0; }
  .hero-banner__button { display: inline-block; padding: 12px 32px; text-decoration: none; font-weight: 600; border-radius: 4px; }
  .hero-banner__button--primary { background-color: var(--btn-bg); color: var(--btn-text); }
  .hero-banner__button--secondary { background-color: transparent; border: 2px solid var(--btn-bg); color: var(--btn-bg); }
</style>

{%- comment -%} CSS restante (estilos não-críticos) carregado de forma assíncrona {%- endcomment -%}
<link rel="stylesheet" href="{{ 'section-hero-banner.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript><link rel="stylesheet" href="{{ 'section-hero-banner.css' | asset_url }}"></noscript>

<section class="hero-banner" style="min-height: {{ section.settings.altura_minima }}px;">
  {%- if section.settings.imagem_fundo -%}
    {{
      section.settings.imagem_fundo
      | image_url: width: 1920
      | image_tag: class: 'hero-banner__imagem-fundo', loading: 'eager', alt: ''
    }}
  {%- endif -%}

  {%- assign overlay_opacity = section.settings.opacidade_overlay | times: 0.01 -%}
  <div
    class="hero-banner__overlay"
    style="background-color: {{ section.settings.cor_overlay | color_modify: 'alpha', overlay_opacity }};"
  >
    {%- comment %} Proteção contra formatadores {%- endcomment %}
  </div>

  <div class="hero-banner__conteudo hero-banner__conteudo--{{ section.settings.alinhamento }}">
    {% for block in section.blocks %}
      {% case block.type %}
        {% when 'heading' %}
          <{{ block.settings.tamanho_titulo }}
            class="hero-banner__heading"
            style="color: {{ block.settings.cor_titulo }};"
            {{ block.shopify_attributes }}
          >
            {{- block.settings.texto_titulo | escape -}}
          </{{ block.settings.tamanho_titulo }}>
        {% when 'paragraph' %}
          <div
            class="hero-banner__text"
            style="color: {{ block.settings.cor_paragrafo }};"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.texto_paragrafo }}
          </div>
        {% when 'button' %}
          <a
            href="{{ block.settings.link_botao }}"
            class="hero-banner__button hero-banner__button--{{ block.settings.estilo_botao }}"
            style="--btn-bg: {{ block.settings.cor_botao }}; --btn-text: {{ block.settings.cor_texto_botao }};"
            {{ block.shopify_attributes }}
          >
            {{- block.settings.texto_botao | escape -}}
          </a>
        {% when 'image' %}
          {% if block.settings.imagem != blank %}
            <div class="hero-banner__bloco-imagem" {{ block.shopify_attributes }}>
              {{
                block.settings.imagem
                | image_url: width: block.settings.largura_imagem
                | image_tag: class: 'hero-banner__img', alt: block.settings.alt_imagem, loading: 'eager'
              }}
            </div>
          {% endif %}
      {% endcase %}
    {% endfor %}
  </div>
</section>
