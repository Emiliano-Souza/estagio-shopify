{% comment %}
  Exercício 2.1 — Liquid Básico
  Estagiário: [seu nome]
{% endcomment %}
{% schema %}
{
  "name": "Exercício Liquid Básico",
  "settings": [
    {
      "type": "text",
      "id": "titulo",
      "label": "Título da seção",
      "default": "Bem-vindo à nossa loja"
    },
    {
      "type": "richtext",
      "id": "descricao",
      "label": "Descrição",
      "default": "<p>Aqui você encontra os melhores produtos.</p>"
    },
    {
      "type": "range",
      "id": "quantidade_produtos",
      "label": "Quantidade de produtos para exibir",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "grid", "label": "Grade" },
        { "value": "list", "label": "Lista" }
      ],
      "default": "grid"
    },
    {
      "type": "color",
      "id": "cor_fundo",
      "label": "Cor de fundo",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "texto_botao",
      "label": "Texto do botão",
      "default": "Ver todos os produtos"
    },
    {
      "type": "url",
      "id": "link_botao",
      "label": "Link do botão"
    }
  ],
  "presets": [
    {
      "name": "Exercício Liquid Básico"
    }
  ]
}
{% endschema %}
<section class="exercicio-basico" style="background-color: {{ section.settings.cor_fundo }};">
  {%- comment -%}
    TAREFA 1: Exibir o título usando a setting
    - Usar {{ section.settings.titulo }}
    - Envolver em uma tag <h2>
  {%- endcomment -%}

  <h2>{{ section.settings.titulo }}</h2>

  {%- comment -%}
    TAREFA 2: Exibir a descrição
    - Usar {{ section.settings.descricao }}
    - A descrição já vem com tags HTML (richtext)
  {%- endcomment -%}

  <div class="descricao">{{ section.settings.descricao }}</div>

  {%- comment -%}
    TAREFA 3: Listar os primeiros N produtos da loja
    - Usar collections.all.products para acessar todos os produtos
    - Usar for loop com limit baseado na setting quantidade_produtos
    - Para cada produto, exibir:
        a) Imagem do produto (usar product.featured_image | image_url: width:
        b) Título do produto (product.title)
        c) Preço formatado (product.price | money)- Envolver cada produto em uma <div class="produto-item">
  {%- endcomment -%}
  {%- comment -%}
    TAREFA 4: Adicionar uma condição para o layout- Se section.settings.layout for "grid", adicionar classe "layout-grid"- Se for "list", adicionar classe "layout-list"- Dica: usar {% if %} ou uma variável com {% assign %}- Aplicar a classe no container dos produtos
  {%- endcomment -%}

  <div class="{% if section.settings.layout == 'grid' %}layout-grid{% else %}layout-list{% endif %}">
    {% for product in collections.all.products limit: section.settings.quantidade_produtos %}
      <div class="produto-item">
        {% if product.featured_image %}
          <img
            src="{{ product.featured_image | image_url: width: 300 }}"
            alt="{{ product.title }}"
            width="300"
            height="300"
          >
        {% endif %}
        <h3>{{ product.title }}</h3>
        <p class="preco">{{ product.price | money }}</p>
      </div>
    {% endfor %}
  </div>

  {% if section.settings.texto_botao and section.settings.link_botao != blank %}
    <div class="botao-container">
      <a href="{{ section.settings.link_botao | default: '/collections/all' }}" class="botao-produtos">
        {{ section.settings.texto_botao }}
      </a>
    </div>
  {% endif %}
</section>
<style>
  .exercicio-basico {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
  }
  .exercicio-basico h2 {
    text-align: center;
    margin-bottom: 0.5rem;
  }
  .exercicio-basico .descricao {
    text-align: center;
    color: #666;
    margin-bottom: 2rem;
  }
  /* Layout Grid */
  .layout-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 1.5rem;
  }
  /* Layout Lista */
  .layout-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .produto-item {
    border: 1px solid #eee;
    border-radius: 8px;
    padding: 1rem;
    text-align: center;
  }
  .produto-item img {
    max-width: 100%;
    height: auto;
    border-radius: 4px;
  }
  .produto-item h3 {
    margin: 0.5rem 0 0.25rem;
    font-size: 1rem;
  }
  .produto-item .preco {
    color: #333;
    font-weight: bold;
  }
  /* Adicione seus estilos adicionais aqui */

  .botao-container {
    text-align: center;
    margin-top: 2rem;
  }

  .botao-produtos {
    display: inline-block;
    padding: 12px 24px;
    background: #000;
    color: #fff;
    text-decoration: none;
    border-radius: 6px;
    font-weight: bold;
  }
</style>
